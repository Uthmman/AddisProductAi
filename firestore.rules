rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading the auth password for the login flow
    match /settings/auth {
      allow read: if true;
    }
    // Allow reading and writing SKU counters for product creation
    match /skuCounters/counters {
      allow read, write: if true;
    }
  }
}